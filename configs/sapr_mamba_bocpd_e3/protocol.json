{
  "protocol_version": "sapr_sim_bocpd_e3.0",
  "status": "frozen_before_generation",
  "study_role": "exploratory; validation-only candidate selection",
  "models": [
    "M0",
    "M1",
    "DLinear",
    "SeasonalNaive",
    "M2",
    "M3-bocpd",
    "M3-constant-gate",
    "M3-bocpd-shuffle",
    "M3-oracle"
  ],
  "seeds": [
    20263301,
    20263302,
    20263303,
    20263304,
    20263305
  ],
  "training": {
    "device": "cuda:0",
    "amp": true,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "batch_size": 64,
    "max_epochs": 40,
    "patience": 7,
    "samples_per_epoch": 24000,
    "validation_samples": 8000,
    "gradient_clip_norm": 1
  },
  "evaluation": {
    "bootstrap_replicates": 10000,
    "horizons": [
      12,
      24,
      48,
      96
    ],
    "primary_metric": "raw_path_rmse",
    "multiple_testing": "Holm within frozen families A-I"
  },
  "state_threshold": {
    "source": "training origins only",
    "quantile": 0.8,
    "minimum": 0.01,
    "maximum": 0.99
  },
  "detector_discrimination": {
    "required_mechanisms": [
      "trend_break",
      "seasonal_change"
    ],
    "minimum_visible_minus_stable_rate": 0.1
  },
  "coverage_gate": {
    "minimum_true_stable_origins": 200,
    "minimum_true_visible_origins": 100,
    "minimum_true_unseen_origins": 100,
    "minimum_detector_stable_origins": 100,
    "minimum_detector_change_origins": 100
  },
  "selection_uses_test_results": false,
  "forbidden": [
    "use_test_metrics_for_candidate_selection",
    "use_oracle_in_primary_decision"
  ]
}
